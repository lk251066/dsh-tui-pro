{
  "name": "@lk251066/dsh-tui",
  "description": "Interactive terminal UI plugin for DeepSeek Harness",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./prompt": {
      "types": "./lib/prompt.d.ts",
      "default": "./lib/prompt.js"
    },
    "./workspace-agent-loop": {
      "types": "./lib/workspace-agent-loop.d.ts",
      "default": "./lib/workspace-agent-loop.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lk251066/dsh-tui-pro.git",
    "directory": "packages/dsh-tui"
  },
  "keywords": [
    "deepseek",
    "harness",
    "tui",
    "terminal",
    "dsh-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
