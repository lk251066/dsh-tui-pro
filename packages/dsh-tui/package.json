    "@deepseek-ai/dsh-tool-ask-user": "^0.1.0-rc.6",
    "@earendil-works/pi-tui": "0.80.7",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.5",
    "saxes": "6.0.0",
