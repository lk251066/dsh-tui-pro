{
  "name": "@lk251066/dsh-tui",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-tui/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": "^11.7.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:transcript": "tsx scripts/benchmark-transcript.ts",
    "docs:screenshot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/capture-readme-screenshot.ps1",
    "typecheck": "tsc -b tsconfig.host.json",
    "lint": "oxlint packages",
    "pack:artifact": "node scripts/pack-artifact.mjs",
    "verify:public-host": "node scripts/verify-public-dsh-host.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.80.7",
    "@types/node": "^22.10.5",
