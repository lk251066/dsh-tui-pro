    "@xterm/headless": "^5.5.0",
    "get-east-asian-width": "1.6.0",
    "gifenc": "^1.0.3",
    "marked": "18.0.5",
    "oxlint": "^0.18.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  }
}
